# Banco de dados
# Dev: SQLite (zero configuracao). Producao: troque o provider em prisma/schema.prisma
# para "postgresql" e aponte a DATABASE_URL para o seu Postgres.
DATABASE_URL="file:./dev.db"

# Segredo usado para assinar os cookies de sessao (JWT HS256).
# Gere um novo com: openssl rand -base64 48
AUTH_SECRET="troque-este-valor-por-um-segredo-aleatorio-de-no-minimo-32-chars"

# URL publica da aplicacao (usada em links de notificacao)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Token usado pelas rotinas agendadas (/api/cron/*)
CRON_SECRET="defina-um-token-para-o-agendador"
